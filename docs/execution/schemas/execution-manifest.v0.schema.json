{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deiiiiii93/quantark/docs/execution/schemas/execution-manifest.v0.schema.json",
  "title": "QuantArk execution ReproducibilityManifest (execution-manifest/0)",
  "description": "JSON form of quantark.execution.manifest.ReproducibilityManifest (dataclasses.asdict + JSON round-trip; tuples serialize as arrays). Readers reject unknown major schema versions rather than guessing (spec section 22).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_fingerprint",
    "plan_fingerprint",
    "adapter_id",
    "adapter_version",
    "engine_class_path",
    "versions",
    "platform",
    "resolved_policy",
    "preparation_fingerprint"
  ],
  "properties": {
    "schema_version": {"const": "execution-manifest/0"},
    "request_fingerprint": {"type": ["string", "null"]},
    "plan_fingerprint": {"type": ["string", "null"]},
    "adapter_id": {"type": "string"},
    "adapter_version": {"type": "string"},
    "engine_class_path": {"type": "string"},
    "versions": {"$ref": "#/$defs/pairs"},
    "platform": {"type": "string"},
    "resolved_policy": {"$ref": "#/$defs/pairs"},
    "preparation_fingerprint": {"type": ["string", "null"]}
  },
  "$defs": {
    "value": {
      "anyOf": [
        {"type": ["string", "number", "boolean", "null"]},
        {"type": "array", "items": {"$ref": "#/$defs/value"}}
      ]
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
          {"type": "string"},
          {"$ref": "#/$defs/value"}
        ],
        "items": false
      }
    }
  }
}
